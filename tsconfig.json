{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"], "isolatedModules": true
  },
  "include": ["src", "tests"]
}
